    "test:n-in-a-row": "node tests/n-in-a-row-logic.mjs",
    "test:sudoku": "node tests/sudoku-logic.mjs",
    "test:go-cube": "node tests/go-cube-logic.mjs",
    "test:expanded-games:smoke": "node tests/expanded-games-smoke.mjs",
    "test:launcher:smoke": "node tests/launcher-visual-smoke.mjs",
    "test:tarzan-swing": "node tests/tarzan-swing-logic.mjs",
